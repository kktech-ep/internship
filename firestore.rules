rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStudent(data) {
      return data is map
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('studentCode' in data) || (data.studentCode is string && data.studentCode.size() <= 64))
        && (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 64))
        && (!('accumulatedHours' in data) || (data.accumulatedHours is number && data.accumulatedHours >= 0 && data.accumulatedHours <= 5000))
        && (!('actualWeeks' in data) || (data.actualWeeks is number && data.actualWeeks >= 0 && data.actualWeeks <= 30));
    }

    function isValidCompany(data) {
      return data is map
        && data.keys().hasAll(['id', 'name'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 300
        && (!('studentsCount' in data) || (data.studentsCount is number && data.studentsCount >= 0 && data.studentsCount <= 500));
    }

    function isValidSubmission(data) {
      return data is map
        && data.keys().hasAll(['id', 'studentId', 'weekNumber', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.studentId is string && data.studentId.size() <= 128
        && data.weekNumber is number && data.weekNumber >= 1 && data.weekNumber <= 18
        && data.status in ['pending', 'graded', 'draft']
        && (!('totalHours' in data) || (data.totalHours is number && data.totalHours >= 0 && data.totalHours <= 168))
        && (!('teacherScore' in data) || (data.teacherScore is number && data.teacherScore >= 0 && data.teacherScore <= 20))
        && (!('dailyLogs' in data) || (data.dailyLogs is list && data.dailyLogs.size() <= 14))
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 20));
    }

    function isValidForm3(data) {
      return data is map
        && data.keys().hasAll(['id', 'studentId', 'companyName', 'teacherName'])
        && data.id is string && data.id.size() <= 128
        && data.studentId is string && data.studentId.size() <= 128
        && data.companyName is string && data.companyName.size() <= 300
        && data.teacherName is string && data.teacherName.size() <= 500
        && (!('studentCode' in data) || (data.studentCode is string && data.studentCode.size() <= 1000))
        && (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 2000))
        && (!('studentRoom' in data) || (data.studentRoom is string && data.studentRoom.size() <= 500))
        && (!('studentCount' in data) || (data.studentCount is number && data.studentCount >= 0 && data.studentCount <= 200))
        && (!('studentIds' in data) || (data.studentIds is list && data.studentIds.size() <= 100 && (data.studentIds.size() == 0 || data.studentIds[0] is string)))
        && (!('studentCodes' in data) || (data.studentCodes is list && data.studentCodes.size() <= 100 && (data.studentCodes.size() == 0 || data.studentCodes[0] is string)))
        && (!('studentNames' in data) || (data.studentNames is list && data.studentNames.size() <= 100 && (data.studentNames.size() == 0 || data.studentNames[0] is string)))
        && (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 20))
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 10));
    }

    function isValidTeachingReport(data) {
      return data is map
        && data.keys().hasAll(['id', 'reporterName', 'weekNumber', 'courses'])
        && data.id is string && data.id.size() <= 128
        && data.reporterName is string && data.reporterName.size() > 0 && data.reporterName.size() <= 150
        && data.weekNumber is number && data.weekNumber >= 1 && data.weekNumber <= 18
        && data.courses is list && data.courses.size() <= 30
        && (!('weekPhotos' in data) || (data.weekPhotos is list && data.weekPhotos.size() <= 10));
    }

    function isValidUserAvatar(data) {
      return data is map
        && data.keys().hasAll(['id', 'email', 'avatarUrl'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.avatarUrl is string && data.avatarUrl.size() <= 900000;
    }

    function isValidSiteStats(data) {
      return data is map
        && data.keys().hasAll(['id', 'totalVisits', 'updatedAt'])
        && data.keys().hasOnly(['id', 'totalVisits', 'updatedAt'])
        && data.id is string && data.id == 'portal'
        && data.totalVisits is number && data.totalVisits >= 0 && data.totalVisits <= 100000000
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidOnlineSession(data) {
      return data is map
        && data.keys().hasAll(['id', 'role', 'lastSeenMs', 'updatedAt'])
        && data.keys().hasOnly(['id', 'role', 'lastSeenMs', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.role is string && data.role in ['student', 'teacher', 'admin', 'guest']
        && data.lastSeenMs is number && data.lastSeenMs >= 0
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    match /students/{studentId} {
      allow list: if true;
      allow get: if isValidId(studentId);
      allow create, update: if isValidId(studentId) && isValidStudent(request.resource.data);
      allow delete: if isValidId(studentId);
    }

    match /companies/{companyId} {
      allow list: if true;
      allow get: if isValidId(companyId);
      allow create, update: if isValidId(companyId) && isValidCompany(request.resource.data);
      allow delete: if isValidId(companyId);
    }

    match /submissions/{submissionId} {
      allow list: if true;
      allow get: if isValidId(submissionId);
      allow create, update: if isValidId(submissionId) && isValidSubmission(request.resource.data);
      allow delete: if isValidId(submissionId);
    }

    match /form3_supervisions/{recordId} {
      allow list: if true;
      allow get: if isValidId(recordId);
      allow create, update: if isValidId(recordId) && isValidForm3(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    match /teaching_reports/{reportId} {
      allow list: if true;
      allow get: if isValidId(reportId);
      allow create, update: if isValidId(reportId) && isValidTeachingReport(request.resource.data);
      allow delete: if isValidId(reportId);
    }

    match /user_avatars/{avatarId} {
      allow list: if true;
      allow get: if isValidId(avatarId);
      allow create, update: if isValidId(avatarId) && isValidUserAvatar(request.resource.data);
      allow delete: if isValidId(avatarId);
    }

    match /announcements/{announcementId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(announcementId) && (request.method == 'get' || request.method == 'delete' || request.resource.data is map);
    }

    match /courses/{courseId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(courseId) && (request.method == 'get' || request.method == 'delete' || request.resource.data is map);
    }

    match /teachers/{teacherId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(teacherId) && (request.method == 'get' || request.method == 'delete' || request.resource.data is map);
    }

    match /users/{userId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(userId) && (request.method == 'get' || request.method == 'delete' || request.resource.data is map);
    }

    match /login_sheet/{rowId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(rowId) && (request.method == 'get' || request.method == 'delete' || request.resource.data is map);
    }

    match /site_stats/{statId} {
      allow list: if false;
      allow get: if isValidId(statId) && statId == 'portal';
      allow create: if isValidId(statId) && statId == 'portal' && isValidSiteStats(request.resource.data);
      allow update: if isValidId(statId) && statId == 'portal' && isValidSiteStats(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVisits', 'updatedAt']);
      allow delete: if false;
    }

    match /online_sessions/{sessionId} {
      allow list: if true;
      allow get: if isValidId(sessionId);
      allow create: if isValidId(sessionId) && isValidOnlineSession(request.resource.data);
      allow update: if isValidId(sessionId) && isValidOnlineSession(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'lastSeenMs', 'updatedAt']);
      allow delete: if isValidId(sessionId);
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
    }
  }
}

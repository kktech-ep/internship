{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Dual vocational internship student record synced from Google Sheets and Form 1.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 200 },
        "level": { "type": "string", "maxLength": 64 },
        "department": { "type": "string", "maxLength": 200 },
        "room": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 64 },
        "companyName": { "type": "string", "maxLength": 300 },
        "supervisorTeacher": { "type": "string", "maxLength": 200 },
        "accumulatedHours": { "type": "number" },
        "requiredHours": { "type": "number" },
        "actualWeeks": { "type": "number" },
        "totalWeeks": { "type": "number" }
      },
      "required": ["id", "studentCode", "name"]
    },
    "Company": {
      "title": "Company",
      "description": "Workplace establishment hosting internship students.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 300 },
        "studentsCount": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "scheduled_today", "scheduled_soon", "pending"] }
      },
      "required": ["id", "name"]
    },
    "WeeklySubmission": {
      "title": "WeeklySubmission",
      "description": "Student weekly internship logbook submission (weeks 1-18).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "weekNumber": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "graded", "draft"] },
        "taskTitle": { "type": "string", "maxLength": 500 },
        "totalHours": { "type": "number" },
        "teacherScore": { "type": "number" }
      },
      "required": ["id", "studentId", "weekNumber"]
    },
    "Form3SupervisionRecord": {
      "title": "Form3SupervisionRecord",
      "description": "Supervisor teacher workplace visit & evaluation record (Form 3, 1 record per workplace visit).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentIds": { "type": "array", "description": "All covered student IDs in this workplace supervision visit" },
        "studentCode": { "type": "string", "maxLength": 1000 },
        "studentCodes": { "type": "array", "description": "All covered student codes" },
        "studentName": { "type": "string", "maxLength": 2000 },
        "studentNames": { "type": "array", "description": "All covered student names" },
        "studentRoom": { "type": "string", "maxLength": 500 },
        "studentCount": { "type": "number" },
        "companyName": { "type": "string", "maxLength": 300 },
        "teacherName": { "type": "string", "maxLength": 500 },
        "score": { "type": "number" },
        "grade": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "studentId", "companyName", "teacherName"]
    },
    "TeachingReportRecord": {
      "title": "TeachingReportRecord",
      "description": "Weekly workplace teaching report submitted by teachers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherKey": { "type": "string", "maxLength": 150 },
        "reporterName": { "type": "string", "maxLength": 150 },
        "weekNumber": { "type": "number" },
        "learningOutcome": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "reporterName", "weekNumber"]
    },
    "UserAvatarRecord": {
      "title": "UserAvatarRecord",
      "description": "Profile avatar mapping for students, teachers, and admins.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "avatarUrl": { "type": "string", "maxLength": 900000 }
      },
      "required": ["id", "email", "avatarUrl"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student internship profiles"
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Unified company directory"
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/WeeklySubmission" },
      "description": "Weekly internship logs"
    },
    "/form3_supervisions/{recordId}": {
      "schema": { "$ref": "#/entities/Form3SupervisionRecord" },
      "description": "Supervisor evaluation records"
    },
    "/teaching_reports/{reportId}": {
      "schema": { "$ref": "#/entities/TeachingReportRecord" },
      "description": "Teacher weekly workplace teaching reports"
    },
    "/user_avatars/{avatarId}": {
      "schema": { "$ref": "#/entities/UserAvatarRecord" },
      "description": "Compressed profile photos"
    }
  }
}

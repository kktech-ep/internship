  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Individual student intern profile and training records"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Supervisor and course instructor records"
    },
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Unified login account directory synced from Google Sheet login tab"
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Host enterprise training location records and supervision schedule"
    },
    "/submissions/{submissionId}": {
      "schema": "WeeklySubmission",
      "description": "Weekly logbook entries, hours, and evaluation reports"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Official announcements for academic term 2/2569"
    },
    "/form3_supervisions/{recordId}": {
      "schema": "Form3Supervision",
      "description": "Teacher on-site supervision reports, scores, and photos (Form_3)"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Course-room-supervisor mapping synced from Google Sheet data tab"
    },
    "/login_sheet/{userId}": {
      "schema": "LoginSheetRow",
      "description": "Mirrored rows from Google Spreadsheet login tab"
    }
